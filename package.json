{
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3"
  },
  "scripts": {
    "test:server": "npm --prefix server run test -- --fileParallelism=false",
    "test:client": "npm --prefix client run test",
    "test": "npm run test:server && npm run test:client",
    "test:lab3": "npm --prefix server run test -- --fileParallelism=false tests/lab-03/ && npm --prefix client run test -- tests/lab-03/",
    "test:lab2": "npm --prefix server run test -- --fileParallelism=false tests/lab-02/ && npm --prefix client run test -- tests/lab-02/",
    "prisma:generate": "npx prisma generate --schema server/prisma/schema.prisma",
    "seed": "npm --prefix server run prisma:seed",
    "check:actions": "node scripts/check-actions.js",
    "test:e2e:lab4": "playwright test --config playwright.lab4.config.ts",
    "test:e2e:lab4:headed": "playwright test --config playwright.lab4.config.ts --headed",
    "typecheck:e2e:lab4": "tsc -p e2e/tsconfig.json",
    "test:qa:lab4": "playwright test --config playwright.lab4-qa.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
