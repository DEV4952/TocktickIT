# Dedicated local PostgreSQL test database (preferred). Never use production.
# E2E_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/toktickit_e2e?schema=public
# Alternative: opt into UUID fixtures on the configured local development DB.
# E2E_ALLOW_SHARED_DEV_DB=1
# Use installed Chrome, or omit to use Playwright Chromium after browser install.
# E2E_BROWSER_CHANNEL=chrome
E2E_API_PORT=3109
E2E_WEB_PORT=5189
